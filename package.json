{
  "name": "modelpulse",
  "displayName": "ModelPulse",
  "description": "At-a-glance AI model quota monitoring in your VS Code status bar with rich hover tooltips.",
  "version": "0.1.0",
  "publisher": "antigravity",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "antigravity",
    "ai",
    "quota",
    "status bar",
    "monitor"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agStatusBar.showDetails",
        "title": "Show Model Quota Details",
        "category": "Antigravity"
      },
      {
        "command": "agStatusBar.refresh",
        "title": "Refresh Quota Data",
        "category": "Antigravity",
        "icon": "$(sync)"
      }
    ],
    "configuration": {
      "title": "Antigravity Status Bar",
      "properties": {
        "agStatusBar.refreshInterval": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 3600,
          "description": "Interval in seconds to refresh quota data."
        },
        "agStatusBar.isPremiumUser": {
          "type": "boolean",
          "default": false,
          "description": "Whether the user has a premium membership (shows extra models)."
        },
        "agStatusBar.displayFormat": {
          "type": "string",
          "default": "standard",
          "enum": [
            "standard",
            "compact",
            "minimal"
          ],
          "enumDescriptions": [
            "🟢 Claude: 80% | 🟡 Gemini: 40%",
            "🟢80% | 🟡40%",
            "🟢🟡🔴 (dots only)"
          ],
          "description": "Format of the status bar display."
        },
        "agStatusBar.warningThreshold": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 80,
          "description": "Quota below this percentage shows yellow warning."
        },
        "agStatusBar.criticalThreshold": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "maximum": 50,
          "description": "Quota below this percentage shows red danger alert."
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/build.js",
    "build": "node scripts/build.js",
    "build:prod": "node scripts/build.js --production",
    "watch": "node scripts/build.js --watch",
    "package": "npx vsce package",
    "vscode:prepublish": "npm run build:prod"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.0"
  }
}
